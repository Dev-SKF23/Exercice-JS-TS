/*  EXO A
Crée une variable note avec une valeur de ton choix (entre 0 et 20).
Écris une condition qui affiche :

"Excellent" si la note est supérieure ou égale à 16
"Bien" si la note est entre 10 et 15 (inclus)
"Insuffisant" si la note est inférieure à 10 */

let note = 20;
if (note >= 16){
    console.log("Votre moyenne est:", note, "Mention Excellent")
}
else if ( note  >= 10 && note <= 15){
    console.log("Votre moyenne est:", note ,"Mention Bien")
}
else{
    console.log("Moyenne insuffisante")
}

